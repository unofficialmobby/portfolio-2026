---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import Journey from '../components/Journey.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import BentoGrid from '../components/BentoGrid.astro';
import Research from '../components/Research.astro';
import InteractiveBackground from '../components/InteractiveBackground.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import FloatingNav from '../components/FloatingNav.astro';
import Footer from '../components/Footer.astro';
---

<html lang="de">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/jonasicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
        <meta name="description" content="Portfoliowebsite by Jonas Heinze. Universally interested Information System Student from Munich." />
        <meta property="og:title" content="Jonas Heinze | Portfolio 2026" />
        <meta property="og:description" content="Interactive webexperience, Showcases and academic findings by Jonas Heinze" />
        <meta property="og:image" content="https://jonasheinze.org/images/og-image.png" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
		<title>Jonas | Portfolio</title>
        <style>
            /* Canvas sichtbar machen */
            body { background-color: transparent; }
            
            /* Footer-Fix: Mehr Platz nach unten */
            .grand-finale-spacer {
                height: 50vh; 
                display: flex;
                align-items: center;
                justify-content: center;
                pointer-events: none;
                /* HIER IST DIE ÄNDERUNG: */
                padding-bottom: 10rem; /* Schiebt den Text hoch, weg von der Nav */
                box-sizing: border-box;
            }
            
            .scroll-hint {
                color: rgba(255, 255, 255, 0.4);
                font-family: monospace;
                font-size: 1rem;
                opacity: 0;
                animation: fadeIn 2s ease-in forwards 0.5s;
            }
            
            @keyframes fadeIn { to { opacity: 1; } }
        </style>
        <script type="application/ld+json">
            {
            "@context": "https://jonasheinze.org",
            "@type": "Person",
            "name": "Jonas Heinze",
            "jobTitle": "Information Systems Student & Kaufmann fuer Digitalisierungsmanagement",
            "url": "https://jonasheinze.org",
            "sameAs": [
            "https://www.linkedin.com/in/jonas-heinze-53a411168/"
            ],
                "knowsAbout": ["Artificial Intelligence", "Astro", "Web Development", "Systemic Analysis", "Public Speaking", "Information Systems", "Data Analysis"]
            }
        </script>
	</head>
	<body>
        <div class="noise-overlay"></div>
        <InteractiveBackground />
        <SmoothScroll />
        <FloatingNav />

		<main>
            <Hero />
            <Journey />
            <ProjectShowcase />
            <BentoGrid />
            <Research />          
            <Footer />
        </main>
	</body>
    

</html>